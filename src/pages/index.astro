---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Changelog from '../components/Changelog.astro';
import Postmortems from '../components/Postmortems.astro';
import Dependencies from '../components/Dependencies.astro';
import PageMe from '../components/PageMe.astro';

const title = `${site.name} · DevOps Engineer`;
const description =
  "DevOps engineer who owns products in production, including SparrowPay, SurveySparrow's payment platform, and SparrowGenie.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <Services />
      <Changelog />
      <Postmortems />
      <Dependencies />
    </main>
    <PageMe />
  </body>
</html>
