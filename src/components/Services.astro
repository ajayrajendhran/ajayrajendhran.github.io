---
import { services } from '../data/services';
---

<section id="services" class="wrap section">
  <div class="head">
    <h2 class="section-title">Services I own</h2>
    <p class="mono meta">owner: ajay · scope: end to end</p>
  </div>

  <div class="tabs" role="tablist" aria-label="Services">
    {
      services.map((s, i) => (
        <button
          class="tab"
          role="tab"
          id={`tab-${s.id}`}
          aria-controls={`panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="tab-name">● {s.name}</span>
          <span class="tab-kind mono">{s.kind}</span>
        </button>
      ))
    }
  </div>

  {
    services.map((s, i) => (
      <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
        <div class="about">
          <span class="badge mono">
            <span class="dot pulse" aria-hidden="true" /> OPERATIONAL · OWNED SINCE {s.since.toUpperCase()}
          </span>
          <h3>{s.name}</h3>
          <p class="kind mono">{s.kind}</p>
          <p class="summary">{s.summary}</p>
          <p class="role">{s.role}</p>
        </div>
        <div class="layers">
          <div class="layers-head mono">
            <span>LAYER</span>
            <span>WHAT I OWN</span>
          </div>
          {s.layers.map((l) => (
            <div class="layer">
              <div class="layer-name mono">
                <span class="dot" aria-hidden="true" />
                {l.layer}
              </div>
              <div class="layer-what">{l.what}</div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#services [role="tab"]'));

  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    }
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    font-size: 13px;
    color: #a9aeb6;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    flex: 1 1 240px;
    min-height: 64px;
    text-align: left;
    padding: 18px 20px;
    background: transparent;
    color: var(--text);
    border: 0;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-family: var(--sans);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tab:hover {
    background: var(--surface);
  }
  .tab[aria-selected='true'] {
    background: var(--surface-2);
    border-bottom-color: var(--accent);
  }
  .tab-name {
    font-size: 20px;
    font-weight: 700;
  }
  .tab-kind {
    font-size: 12px;
    color: #a9aeb6;
  }
  .panel {
    padding-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }
  .panel[hidden] {
    display: none;
  }
  .about {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid #2a2e35;
    border-radius: 999px;
    font-size: 12px;
    color: var(--accent);
  }
  .about h3 {
    font-size: 40px;
    line-height: 1.05;
  }
  .kind {
    font-size: 14px;
    color: var(--accent);
  }
  .summary {
    font-size: 18px;
    color: #c6cad0;
  }
  .role {
    font-size: 16px;
    color: var(--text-dim);
    border-top: 1px solid var(--line);
    padding-top: 18px;
  }
  .layers {
    flex: 1.4 1 460px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .layers-head {
    display: flex;
    justify-content: space-between;
    padding: 12px 20px;
    background: var(--surface);
    font-size: 12px;
    color: #a9aeb6;
    letter-spacing: 0.06em;
  }
  .layer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    padding: 18px 20px;
    border-top: 1px solid var(--line);
  }
  .layer-name {
    flex: 0 0 170px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-strong);
  }
  .layer-what {
    flex: 1 1 260px;
    min-width: 0;
    color: #c6cad0;
    font-size: 16px;
  }
  @media (max-width: 640px) {
    .about h3 {
      font-size: 32px;
    }
    .tab {
      flex-basis: 100%;
    }
  }
</style>
