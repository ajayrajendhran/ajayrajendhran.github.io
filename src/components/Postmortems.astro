---
import { postmortems as items } from '../data/postmortems';
---

{
  items.length > 0 && (
    <section id="postmortems" class="wrap section">
      <h2 class="section-title">Postmortems &amp; wins</h2>
      <p class="section-lede">
        Real problems from production, told blameless-style: what broke or slowed us down, what I did, what changed.
      </p>
      <div class="grid">
        {items.map((p) => (
          <article class:list={['card', { draft: p.draft }]}>
            <div class="top mono">
              <span>{p.id}</span>
              <span class="state">{p.draft ? 'DRAFT' : 'RESOLVED'}</span>
            </div>
            <h3>{p.title}</h3>
            <p><b>Impact:</b> {p.impact}</p>
            <p><b>Fix:</b> {p.fix}</p>
            <p><b>Since then:</b> {p.since}</p>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .card {
    flex: 1 1 340px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card.draft {
    border-style: dashed;
  }
  .top {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #a9aeb6;
  }
  .state {
    color: var(--accent);
  }
  h3 {
    font-size: 19px;
  }
  p {
    font-size: 15px;
    color: var(--text-muted);
  }
  b {
    color: var(--text);
  }
</style>
